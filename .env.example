# Octopus Energy API
# Find your API key in your Octopus account dashboard.
OCTOPUS_API_KEY=
OCTOPUS_ACCOUNT_NUMBER=
# Your electricity meter point and serial (from your latest bill / Octopus dashboard)
OCTOPUS_MPAN=
OCTOPUS_SERIAL=
# Optional export MPAN (for solar feed-in / Flux export)
OCTOPUS_EXPORT_MPAN=
OCTOPUS_EXPORT_SERIAL=

# Enphase Enlighten (optional — not wired up in v1)
ENPHASE_API_KEY=
ENPHASE_SYSTEM_ID=
